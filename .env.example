# Server-side Google Gemini API key used by the Express API routes.
# This value must never be exposed through Vite client env vars.
GEMINI_API_KEY=

# Optional override for the backend AI model
# GEMINI_MODEL=gemini-2.5-flash

# Firebase web app configuration exposed safely to the browser
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_MEASUREMENT_ID=

# Optional when using a non-default Firestore database
VITE_FIREBASE_FIRESTORE_DATABASE_ID=
